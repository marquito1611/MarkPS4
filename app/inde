<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MarkPS4 Theme Store</title>

<style>
:root {
    --fondo: #050b14;
    --panel: #0b1728;
    --panel2: #10243c;
    --azul: #087bff;
    --cian: #39c5ff;
    --blanco: #f4f8ff;
    --texto: #94afd0;
    --borde: #1b4168;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background:
        radial-gradient(ellipse at top right, #102e50 0%, transparent 45%),
        var(--fondo);
    color: var(--blanco);
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
}

header {
    height: 82px;
    display: flex;
    align-items: center;
    padding: 0 38px;
    gap: 16px;
    border-bottom: 1px solid var(--borde);
    background: rgba(5, 11, 20, .94);
}

.logo {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--azul), #0048a8);
    display: grid;
    place-items: center;
    font-size: 25px;
    font-weight: 900;
    box-shadow: 0 0 24px #087bff40;
}

.brand {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 1px;
}

.subtitle {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--cian);
}

.status {
    margin-left: auto;
    color: var(--cian);
    font-size: 11px;
    letter-spacing: 1px;
    border: 1px solid #155b91;
    background: #0a2138;
    border-radius: 20px;
    padding: 9px 13px;
}

.layout {
    display: flex;
    min-height: calc(100vh - 82px);
}

.sidebar {
    width: 225px;
    flex-shrink: 0;
    padding: 34px 18px;
    background: rgba(7, 17, 31, .9);
    border-right: 1px solid var(--borde);
}

.nav-item {
    display: flex;
    gap: 13px;
    align-items: center;
    padding: 16px;
    margin-bottom: 10px;
    border-radius: 10px;
    color: var(--texto);
    cursor: pointer;
    font-size: 15px;
    transition: .2s;
}

.nav-item.active {
    color: white;
    background: linear-gradient(90deg, #087bff, #0752ad);
    box-shadow: 0 5px 20px #087bff30;
}

.nav-item:hover {
    color: white;
    background-color: #132b46;
}

main {
    flex: 1;
    min-width: 0;
    padding: 36px;
}

h1 {
    font-size: 27px;
    margin: 0 0 9px;
}

.description {
    color: var(--texto);
    margin-bottom: 28px;
    font-size: 14px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(250px, 360px));
    gap: 24px;
}

.theme-card {
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: 15px;
    background: linear-gradient(145deg, #10243c, #091523);
    box-shadow: 0 12px 35px #0005;
    transition: transform .2s, border-color .2s;
}

.theme-card:hover {
    transform: translateY(-3px);
    border-color: var(--azul);
}

.artwork {
    height: 210px;
    position: relative;
    overflow: hidden;
    background: #0b1728;
}

.artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.artwork::after {
    content: "";
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, #091523);
    pointer-events: none;
}

.card-content {
    padding: 21px;
}

.game-label {
    color: var(--cian);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 9px;
}

h2 {
    margin: 0 0 10px;
    font-size: 22px;
}

.card-description {
    color: var(--texto);
    font-size: 13px;
    line-height: 1.6;
    min-height: 40px;
}

.file-info {
    border-top: 1px solid #1b3653;
    border-bottom: 1px solid #1b3653;
    margin: 17px 0;
    padding: 13px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 12px;
    color: var(--texto);
}

.file-count {
    color: var(--cian);
    white-space: nowrap;
}

.install-btn {
    width: 100%;
    border: 0;
    border-radius: 8px;
    padding: 15px;
    color: white;
    background: linear-gradient(100deg, #087bff, #0755c7);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 0 5px 18px #087bff35;
    transition: .2s;
}

.install-btn:hover {
    background: linear-gradient(100deg, #2194ff, #087bff);
    box-shadow: 0 0 24px #087bff65;
}

.install-btn:disabled {
    opacity: .6;
    cursor: default;
}

.progress-area {
    display: none;
    margin-top: 18px;
}

.progress-heading {
    display: flex;
    justify-content: space-between;
    color: var(--texto);
    font-size: 12px;
    margin-bottom: 9px;
}

.progress-track {
    height: 8px;
    border-radius: 10px;
    background: #20344a;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--azul), var(--cian));
    box-shadow: 0 0 12px var(--azul);
    transition: width .25s;
}

.empty {
    display: none;
    padding: 28px;
    color: var(--texto);
    background: var(--panel);
    border: 1px solid var(--borde);
    border-radius: 12px;
}

.notice {
    color: var(--texto);
    font-size: 12px;
    margin-top: 27px;
}

@media (max-width: 760px) {
    header {
        padding: 0 18px;
    }

    .sidebar {
        width: 145px;
        padding: 24px 9px;
    }

    main {
        padding: 23px 16px;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .brand {
        font-size: 19px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">M</div>
    <div>
        <div class="brand">MarkPS4</div>
        <div class="subtitle">THEME STORE</div>
    </div>
    <div class="status">● MODO OFFLINE</div>
</header>

<div class="layout">

    <aside class="sidebar">
        <div class="nav-item active" id="navThemes"
             onclick="showTab('themes')">
            <span>▦</span> Temas
        </div>

        <div class="nav-item" id="navInstalled"
             onclick="showTab('installed')">
            <span>✓</span> Instalados
        </div>
    </aside>

    <main>
        <section id="themesSection">
            <h1>Temas</h1>
            <div class="description">
                Personaliza tu PS4 con tus temas favoritos.
            </div>

            <div class="grid">

                <article class="theme-card" id="assassinsCard">

                    <div class="artwork">
                        <!-- Sustituye esta URL por una imagen local
                             incluida en tu proyecto, por ejemplo:
                             assets/assassins-creed.jpg -->
                        <img
                          src="assets/assassins-creed.jpg"
                          alt="Imagen del tema Assassin's Creed"
                          onerror="this.style.display='none';">
                    </div>

                    <div class="card-content">
                        <div class="game-label">Tema para PS4</div>

                        <h2>Assassin's Creed</h2>

                        <div class="card-description">
                            Tema inspirado en Assassin's Creed para
                            personalizar la pantalla de tu consola.
                        </div>

                        <div class="file-info">
                            <span>Paquete completo del tema</span>
                            <span class="file-count">2 archivos PKG</span>
                        </div>

                        <!-- Un solo botón para el tema completo -->
                        <button class="install-btn"
                                id="installButton"
                                onclick="startInstall()">
                            INSTALAR TEMA
                        </button>

                        <div class="progress-area" id="progressArea">
                            <div class="progress-heading">
                                <span id="progressText">
                                    Preparando instalación...
                                </span>
                                <span id="progressPercent">0%</span>
                            </div>

                            <div class="progress-track">
                                <div class="progress-fill"
                                     id="progressFill"></div>
                            </div>
                        </div>
                    </div>
                </article>

            </div>

            <div class="notice">
                Los dos archivos pertenecen al mismo tema y se gestionan
                desde un único botón.
            </div>
        </section>

        <section id="installedSection" style="display:none">
            <h1>Instalados</h1>
            <div class="description">
                Temas que la aplicación ha registrado como instalados.
            </div>
            <div class="empty" id="emptyInstalled">
                Todavía no hay temas registrados como instalados.
            </div>
            <div class="grid" id="installedGrid"></div>
        </section>
    </main>

</div>

<script>
let isInstalling = false;
let isInstalled = false;

function showTab(tab) {
    const themes = tab === "themes";

    document.getElementById("themesSection").style.display =
        themes ? "block" : "none";

    document.getElementById("installedSection").style.display =
        themes ? "none" : "block";

    document.getElementById("navThemes").classList.toggle(
        "active", themes
    );

    document.getElementById("navInstalled").classList.toggle(
        "active", !themes
    );

    if (!themes) {
        renderInstalled();
    }
}

function startInstall() {
    /*
      DEMO VISUAL:
      Esto no instala archivos PKG de verdad.
      La instalación real debe conectarse al mecanismo nativo
      compatible con PS4 y reportar su progreso real.
    */

    if (isInstalling || isInstalled) return;

    isInstalling = true;

    const button = document.getElementById("installButton");
    const area = document.getElementById("progressArea");
    const fill = document.getElementById("progressFill");
    const percent = document.getElementById("progressPercent");
    const text = document.getElementById("progressText");

    button.disabled = true;
    button.textContent = "PROCESANDO...";
    area.style.display = "block";
    text.textContent = "Simulación de progreso";

    let progress = 0;

    const timer = setInterval(() => {
        progress = Math.min(progress + 5, 100);

        fill.style.width = progress + "%";
        percent.textContent = progress + "%";

        if (progress >= 100) {
            clearInterval(timer);

            isInstalling = false;
            isInstalled = true;

            button.textContent = "TEMA PROCESADO";
            text.textContent = "Demostración completada";

            /*
              En la versión nativa, solo se debe marcar instalado
              después de confirmar que ambos PKG se instalaron bien.
            */
            setTimeout(() => showTab("installed"), 500);
        }
    }, 150);
}

function renderInstalled() {
    const grid = document.getElementById("installedGrid");
    const empty = document.getElementById("emptyInstalled");

    grid.innerHTML = "";

    if (!isInstalled) {
        empty.style.display = "block";
        return;
    }

    empty.style.display = "none";

    const card = document.createElement("article");
    card.className = "theme-card";

    card.innerHTML = `
        <div class="card-content">
            <div class="game-label">Tema registrado</div>
            <h2>Assassin's Creed</h2>
            <div class="card-description">
                La demostración de instalación ha finalizado.
            </div>
            <div class="file-info">
                <span>Estado</span>
                <span class="file-count">Completado</span>
            </div>
        </div>
    `;

    grid.appendChild(card);
}
</script>

</body>
</html>
